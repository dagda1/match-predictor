{
  "name": "match-predictor",
  "version": "0.1.0",
  "private": true,
  "description": "Premier League match predictions",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "rm -rf ./packages/*/{tsconfig.*tsbuildinfo,dist}",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "prepare": "tsx ./scripts/prepare.ts",
    "start:frontend": "cross-env NODE_ENV=development pnpm --filter @match-predictor/frontend dev",
    "start:api": "uv run --directory packages/api uvicorn match_predictor_api.main:app --port 4400 --reload",
    "dev": "concurrently -n api,frontend -c blue,green \"pnpm start:api\" \"pnpm start:frontend\"",
    "refresh": "pnpm --filter @match-predictor/etl fetch-data && uv run --directory packages/ml python -m match_predictor.generate_predictions && uv run --directory packages/ml python -m match_predictor.generate_upcoming",
    "test": "cross-env turbo run test:ci"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cutting/assert": "^0.5.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.9",
    "@mui/material": "7.3.9",
    "@mui/system": "7.3.9",
    "@mui/utils": "7.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.13.2",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cutting/eslint-config": "^5.6.0",
    "@cutting/tsconfig": "^4.45.0",
    "@cutting/useful-types": "^4.46.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "10.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.21",
    "typescript": "6.0.2",
    "vite": "8.0.3",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.33.0",
  "volta": {
    "node": "24.11.0",
    "npm": "11.12.1",
    "pnpm": "10.33.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint -c ./eslint.config.mjs --fix --warn-ignored=false"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "react": "19.2.4",
      "react-dom": "19.2.4"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
